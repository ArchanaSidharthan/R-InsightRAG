# ------------------------------------------------------------
# 5. Question-aware financial evidence reranking
# ------------------------------------------------------------

question_lower <- tolower(question)

# Define financial evidence categories based on the question.
question_topics <- character(0)

if (grepl("revenue|sales|income source|royalt|licens|collaboration",
          question_lower)) {
  question_topics <- c(question_topics, "revenue")
}

if (grepl("cash flow|operating cash|cash generated",
          question_lower)) {
  question_topics <- c(question_topics, "cash_flow")
}

if (grepl("commitment|obligation|contract",
          question_lower)) {
  question_topics <- c(question_topics, "commitments")
}

if (grepl("interest rate|market risk|financial risk",
          question_lower)) {
  question_topics <- c(question_topics, "market_risk")
}

if (grepl("debt|financing|liquidity|borrowing",
          question_lower)) {
  question_topics <- c(question_topics, "debt_liquidity")
}

# Normalize passage text for literal keyword matching.
passage_text <- tolower(
  as.character(qa_results$chunk_text)
)

# Helper: count distinct matching terms in one passage.
count_terms <- function(txt, terms) {
  if (length(terms) == 0 || is.na(txt)) {
    return(0L)
  }
  
  sum(vapply(
    unique(terms),
    function(term) grepl(term, txt, fixed = TRUE),
    logical(1)
  ))
}

# Topic-specific evidence terms.
topic_terms <- list(
  revenue = c(
    "revenue",
    "collaboration revenue",
    "licensing revenue",
    "license revenue",
    "royalty",
    "royalties",
    "product revenue",
    "contract revenue",
    "deferred revenue",
    "consolidated statements of operations"
  ),
  
  cash_flow = c(
    "cash flows from operating activities",
    "net cash used in operating activities",
    "net cash provided by operating activities",
    "operating activities",
    "operating cash flow",
    "cash generated",
    "working capital",
    "accounts receivable",
    "deferred revenue"
  ),
  
  commitments = c(
    "commitments",
    "contractual obligations",
    "cancellable",
    "future payments",
    "purchase obligations",
    "lease obligations"
  ),
  
  market_risk = c(
    "market risk",
    "interest rate",
    "credit risk",
    "investment risk",
    "marketable securities"
  ),
  
  debt_liquidity = c(
    "debt",
    "credit facility",
    "term loan",
    "liquidity",
    "cash equivalents",
    "principal payments"
  )
)

# Calculate evidence scores for each requested topic.
for (topic in names(topic_terms)) {
  score_name <- paste0(topic, "_hits")
  
  if (topic %in% question_topics) {
    qa_results[[score_name]] <- vapply(
      passage_text,
      function(txt) count_terms(txt, topic_terms[[topic]]),
      integer(1)
    )
  } else {
    qa_results[[score_name]] <- 0L
  }
}

# Count how many requested topics each passage supports.
topic_score_columns <- paste0(question_topics, "_hits")

if (length(topic_score_columns) > 0) {
  qa_results$topic_coverage <- rowSums(
    qa_results[, topic_score_columns, drop = FALSE] > 0
  )
} else {
  qa_results$topic_coverage <- 0L
}

# Penalize passages dominated by irrelevant report sections.
qa_results$irrelevance_penalty <- vapply(
  passage_text,
  function(txt) {
    penalty <- 0
    
    if (grepl("table of contents", txt, fixed = TRUE)) {
      penalty <- penalty + 0.04
    }
    
    if (grepl("basis for opinion", txt, fixed = TRUE) &&
        !grepl("net cash used in operating activities", txt,
               fixed = TRUE)) {
      penalty <- penalty + 0.05
    }
    
    if (grepl("independent registered public accounting firm", txt,
              fixed = TRUE) &&
        !grepl("net cash used in operating activities", txt,
               fixed = TRUE)) {
      penalty <- penalty + 0.05
    }
    
    penalty
  },
  numeric(1)
)

# Total topic-specific hits.
all_topic_hit_columns <- paste0(
  names(topic_terms),
  "_hits"
)

qa_results$keyword_hits <- rowSums(
  qa_results[, all_topic_hit_columns, drop = FALSE]
)

# Combined heuristic score:
# semantic similarity + topic coverage + keyword evidence
# - irrelevance penalty.
#
# These weights are initial heuristics, not calibrated probabilities.
qa_results$rerank_score <-
  qa_results$similarity +
  0.04 * qa_results$topic_coverage +
  0.005 * qa_results$keyword_hits -
  qa_results$irrelevance_penalty

# Rank the candidate passages.
qa_results <- qa_results[
  order(
    qa_results$rerank_score,
    decreasing = TRUE
  ),
  ,
  drop = FALSE
]

# Keep the five highest-ranked passages.
qa_results <- head(qa_results, 5)

# Assign evidence IDs after final ranking.
qa_results$source_id <- paste0(
  "S",
  seq_len(nrow(qa_results))
)

cat("\nQuestion topics detected:\n")
print(question_topics)

cat("\nReranking summary:\n")

print(
  qa_results[
    ,
    c(
      "source_id",
      "company_name",
      "fiscal_year",
      "similarity",
      "keyword_hits",
      "topic_coverage",
      "irrelevance_penalty",
      "rerank_score"
    ),
    drop = FALSE
  ],
  row.names = FALSE
)




